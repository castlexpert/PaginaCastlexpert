# Copia este archivo a `.env.local` y ajusta los valores.

# Panel WAdministrativo (analytics de visitas → Postgres del admin)
# En producción debe ser la URL pública del admin, p. ej.:
VITE_ADMIN_URL=https://admin.castlexpert.com
# En local (opcional; si no se define, en DEV se usa http://localhost:8790):
# VITE_ADMIN_URL=http://localhost:8790

# Si el sitio estático se sirve en otro dominio que el API Node (Railway), define la URL base del backend para chat/contacto/handoff:
# VITE_PUBLIC_API_URL=https://tu-servicio.up.railway.app

# URL canónica para SEO (meta, JSON-LD). Debe coincidir con `public/robots.txt` / `sitemap.xml` si cambias de dominio:
# VITE_SITE_URL=https://castlexpert.com

# Volumen Railway: carpeta donde se guardan imágenes servidas en /media-sitio/ (mapear volumen /app/archivos_sitio)
# SITIO_FILES_DIR=/app/archivos_sitio

# --- Correo avisos formulario Contáctenos (opcional; si no hay nada, solo se guarda en Postgres) ---
# Opción A — Resend (recomendado): https://resend.com
# RESEND_API_KEY=re_...
# RESEND_FROM=CastleXpert <onboarding@resend.dev>
# Opción B — SMTP (ej. Gmail con contraseña de aplicación)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu@gmail.com
# SMTP_PASS=contraseña_de_aplicacion
# SMTP_FROM=CastleXpert <tu@gmail.com>
# Destinatarios del aviso (coma separada)
# CONTACT_NOTIFY_TO=info@castlexpert.com,castlexpertcr@gmail.com
